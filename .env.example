# Copie para .env e preencha a chave de UM provedor (ou mais).
# Se houver mais de uma, a ordem é: OpenAI, Gemini, Anthropic.
# Para forçar um: ORIENTADOR_PROVEDOR=openai | gemini | anthropic

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

